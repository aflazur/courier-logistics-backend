generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// (Shared across models in other files under prisma/schema/ — Prisma's
// multi-file schema support stitches every .prisma file in this folder
// together at generate/migrate time.)
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  COURIER
  ADMIN
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

enum ShipmentStatus {
  PENDING
  PICKUP_SCHEDULED
  PICKED_UP
  AT_ORIGIN_HUB
  IN_TRANSIT
  AT_DESTINATION_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  SSLCOMMERZ
  STRIPE
  BKASH
}
