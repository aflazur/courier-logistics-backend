# Server
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Database (NeonDB / PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/courier_db?sslmode=require"

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Google OAuth (GCP Social Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
SESSION_SECRET=change_this_session_secret
# Frontend base URL - after Google login the browser is redirected here (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Email notifications (SMTP - e.g. Gmail app password, Mailtrap, Resend SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Courier Platform <no-reply@courier.com>"

# SSLCommerz (sandbox first, then live)
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_LIVE=false
SSLCZ_SUCCESS_URL=http://localhost:5000/api/v1/payments/success
SSLCZ_FAIL_URL=http://localhost:5000/api/v1/payments/fail
SSLCZ_CANCEL_URL=http://localhost:5000/api/v1/payments/cancel
SSLCZ_IPN_URL=http://localhost:5000/api/v1/payments/ipn

# Admin seed credentials (demo account for evaluation)
ADMIN_EMAIL=admin@courier.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Platform Admin

# Redis (caching, rate-limit store)
REDIS_URL=redis://localhost:6379
